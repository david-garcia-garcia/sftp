#!/bin/bash
set -Eeo pipefail

# shellcheck disable=2154
trap 's=$?; echo "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

# Extended regular expression (ERE) for arguments
reUser='[A-Za-z0-9._][A-Za-z0-9._-]{0,31}' # POSIX.1-2008
rePass='[^:]{0,255}'
reUid='[[:digit:]]*'
reGid='[[:digit:]]*'
reDir='[^:]*'
#reArgs="^($reUser)(:$rePass)(:e)?(:$reUid)?(:$reGid)?(:$reDir)?$"

function log() {
    echo "[$0] $*"
}

function validateArg() {
    name="$1"
    val="$2"
    re="$3"

    if [[ "$val" =~ ^$re$ ]]; then
        return 0
    else
        log "ERROR: Invalid $name \"$val\", do not match required regex pattern: $re"
        return 1
    fi
}

# Replace password in log output with asterisks
log "Parsing user data: \"$(echo "$1" | sed 's/\([^:]*:\)[^:]*\(:.*\)/\1******\2/')\""
IFS=':' read -ra args <<< "$1"

skipIndex=0
chpasswdOptions=""
useraddOptions=(--no-user-group --badname)

user="${args[0]}"; validateArg "username" "$user" "$reUser" || exit 1
pass="${args[1]}"; validateArg "password" "$pass" "$rePass" || exit 1

if [ "${args[2]}" == "e" ]; then
    chpasswdOptions="-e"
    skipIndex=1
fi

uid="${args[$((skipIndex+2))]}"; validateArg "UID" "$uid" "$reUid" || exit 1
gid="${args[$((skipIndex+3))]}"; validateArg "GID" "$gid" "$reGid" || exit 1
dir="${args[$((skipIndex+4))]}"; validateArg "dirs" "$dir" "$reDir" || exit 1
expiryDate="${args[$((skipIndex+5))]}"

if getent passwd "$user" > /dev/null; then
    log "WARNING: User \"$user\" already exists. Skipping."
    exit 0
fi

if [ -n "$uid" ]; then
    useraddOptions+=(--non-unique --uid "$uid")
fi

if [ -n "$gid" ]; then
    if ! getent group "$gid" > /dev/null; then
        groupadd --gid "$gid" "group_$gid"
    fi

    useraddOptions+=(--gid "$gid")
fi

useradd "${useraddOptions[@]}" "$user"
mkdir -p "/home/$user"
chown root:root "/home/$user"
chmod 755 "/home/$user"

# Retrieving user id to use it in chown commands instead of the user name
# to avoid problems on alpine when the user name contains a '.'
uid="$(id -u "$user")"

if [ -n "$pass" ]; then
    echo "$user:$pass" | chpasswd $chpasswdOptions
else
    usermod -p "*" "$user" # disabled password
fi

# Add SSH keys to authorized_keys with valid permissions
userKeysQueuedDir="/home/$user/.ssh/keys"
if [ -d "$userKeysQueuedDir" ]; then
    userKeysAllowedFileTmp="$(mktemp)"
    userKeysAllowedFile="/home/$user/.ssh/authorized_keys"

    for publickey in "$userKeysQueuedDir"/*; do
        # Ensure each key ends with a newline to prevent keys from being concatenated on the same line
        # Blank lines in authorized_keys are ignored, so always adding a newline is safe
        { cat "$publickey"; echo; } >> "$userKeysAllowedFileTmp"
    done

    # Remove duplicate keys
    sort < "$userKeysAllowedFileTmp" | uniq > "$userKeysAllowedFile"

    chown "$uid" "$userKeysAllowedFile"
    chmod 600 "$userKeysAllowedFile"
fi

# Make sure dirs exists
if [ -n "$dir" ]; then
    IFS=',' read -ra dirArgs <<< "$dir"
    for dirPath in "${dirArgs[@]}"; do
        dirPath="/home/$user/$dirPath"
        if [ ! -d "$dirPath" ]; then
            log "Creating directory: $dirPath"
            mkdir -p "$dirPath"
            chown -R "$uid:users" "$dirPath"
        else
            log "Directory already exists: $dirPath"
        fi
    done
fi

# Set account expiration date if provided
if [ -n "$expiryDate" ]; then
    log "Setting expiration date for user $user: $expiryDate"
    
    expiryDateFormatted=""
    
    # Check if it's YYYY-MM-DD format (preferred)
    if [[ "$expiryDate" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        expiryDateFormatted="$expiryDate"
    # Check if it's YYYYMMDD format - convert to YYYY-MM-DD
    elif [[ "$expiryDate" =~ ^[0-9]{8}$ ]]; then
        year="${expiryDate:0:4}"
        month="${expiryDate:4:2}"
        day="${expiryDate:6:2}"
        expiryDateFormatted="$year-$month-$day"
    fi
    
    # Set expiration using usermod (works on both Debian and Alpine)
    if [ -n "$expiryDateFormatted" ]; then
        if command -v usermod &> /dev/null; then
            # usermod -e accepts YYYY-MM-DD format
            usermod -e "$expiryDateFormatted" "$user" 2>/dev/null || log "WARNING: Failed to set expiration date for user $user"
        elif command -v chage &> /dev/null; then
            # chage -E accepts YYYY-MM-DD format (GNU chage) or days since epoch
            # Try YYYY-MM-DD first
            chage -E "$expiryDateFormatted" "$user" 2>/dev/null || {
                # If that fails, try converting to days since epoch
                if command -v date &> /dev/null; then
                    expiryEpoch=$(date -d "$expiryDateFormatted" +%s 2>/dev/null || date -j -f "%Y-%m-%d" "$expiryDateFormatted" +%s 2>/dev/null || echo "")
                    if [ -n "$expiryEpoch" ]; then
                        expiryDays=$((expiryEpoch / 86400))
                        chage -E "$expiryDays" "$user" 2>/dev/null || log "WARNING: Failed to set expiration date for user $user"
                    fi
                fi
            }
        else
            log "WARNING: Neither usermod nor chage found, cannot set expiration date for user $user"
        fi
    else
        log "WARNING: Invalid expiration date format: $expiryDate (expected YYYY-MM-DD or YYYYMMDD)"
    fi
fi
